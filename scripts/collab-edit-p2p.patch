@@ -0,0 +1,26 @@
+/** Prefix used when Felarumi and Felanumio are hosted under FiFolders Pages. */
+export function hostBase(): string {
+  const path = location.pathname;
+  if (path === "/felarumi" || path.startsWith("/felarumi/")) return "/felarumi";
+  if (path === "/felanumio" || path.startsWith("/felanumio/")) return "/felanumio";
+  return "";
+}
+
+/** App route, after a Pages 404 redirect (`?spa=`) or the /felarumi and /felanumio prefix. */
+export function routePath(): string {
+  const spa = new URLSearchParams(location.search).get("spa");
+  if (spa) return spa.startsWith("/") ? spa : `/${spa}`;
+  const base = hostBase();
+  let path = location.pathname;
+  if (base && (path === base || path.startsWith(`${base}/`))) path = path.slice(base.length) || "/";
+  if (!path.startsWith("/")) path = `/${path}`;
+  return path || "/";
+}
+
+/** Keep FiFolders query params (and wire) when the editor moves to a document or book. */
+export function withKeptQuery(path: string, hash: string): string {
+  const params = new URLSearchParams(location.search);
+  params.delete("spa");
+  const query = params.toString();
+  return path + (query ? `?${query}` : "") + (hash ? `#${hash}` : "");
+}
